// Configuration JAAS de repli.
//
// Utilisation : exporter CATALINA_OPTS avant de démarrer Tomcat, par exemple
//   set CATALINA_OPTS=-Djava.security.auth.login.config=C:\chemin\jaas.config
// puis retirer <listener>bj.azo.config.JaasInitializer</listener> de web.xml.
//
// Par défaut, l'application enregistre cette même configuration par programme
// (bj.azo.config.AzoJaasConfiguration) : ce fichier sert uniquement de filet
// de sécurité ou de documentation.

Azo {
    bj.azo.security.AzoLoginModule REQUIRED;
};
